# Adzuna API credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_MAX_PAGES=5
# Optional JSON object replacing default role/category keyword matches.
ROLE_KEYWORDS_JSON=

# SMTP app password or provider credentials. Port 465 uses implicit TLS;
# other configured ports use STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Persistent paths; keep these on durable storage.
JOB_MONITOR_DB=data/monitor.sqlite
JOB_MONITOR_BRONZE=data/bronze
JOB_MONITOR_GOLD=docs/data/monitoring.json
COLLECTION_WEEKDAY_HOURS=6,9,12,15,18
COLLECTION_WEEKEND_HOURS=9
